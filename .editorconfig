# Sdílené nastavení formátování pro IntelliJ IDEA i ktlint (verze 1.3.1).
# Hodnota continuation_indent_size musí odpovídat ktlint (přírůstek 4); výchozí
# hodnota IDE (8) způsobuje odlišné odsazení pokračování výrazů a pád ktlintCheck.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = off
ij_kotlin_continuation_indent_size = 4

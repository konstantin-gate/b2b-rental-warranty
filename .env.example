# JWT_SECRET musí mít alespoň 32 znaků; vygenerujte přes: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32-chars
DB_NAME=b2b_rental
DB_USER=b2b
DB_PASS=ch4ng3m3
# JDBC URL pro lokalni spusteni backendu mimo Docker (v Docker rezimu DB_URL
# skladaji docker-compose a tato hodnota se nepouziva)
DB_URL=jdbc:postgresql://127.0.0.1:5432/b2b_rental

# Lokální LLM (llama-server, OpenAI-kompatibilní API)
AI_BASE_URL=http://127.0.0.1:8080/v1
# Název modelu získáte z GET http://127.0.0.1:8080/v1/models
AI_MODEL=
AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=120000
AI_CONNECT_TIMEOUT_MS=5000
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=700
AI_ENABLED=true
# Naplnění demo dat (v produkci nastavte false)
SEED_DEMO_DATA=true
